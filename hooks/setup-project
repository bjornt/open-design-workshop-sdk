#!/usr/bin/bash
# Runs as the workshop user after interfaces are connected. Ensures the
# persisted data directory exists, then enables the daemon as a user service.
set -eu

mkdir -p "$HOME/.local/share/open-design"

# Seed a default project location so "New project" creates its working
# directory automatically. Headless workshops have no display server, so the
# daemon's folder picker (a server-side `zenity --file-selection` dialog behind
# /api/dialog/open-folder) can never open — leaving the web UI with no way to
# choose where a project lives. A configured, default project location bypasses
# the picker entirely: the daemon creates `<location>/<id>` on its own
# (resolveCreateProjectLocationId -> createLocationProjectDir).
#
# Location defaults to $HOME/.local/share/open-design/project — inside the
# persisted open-design-data mount, so it survives workshop updates without
# ever touching the mounted repo. Adding this SDK to a workshop must never
# create files under /project on its own. A consumer can opt into a
# repo-relative location by committing a `/project/.open-design-location`
# file whose first non-comment line is an absolute path, or a name/relative
# path resolved under /project. This file is the only per-project channel a
# workshop hook has: the SDK schema passes no scalar config or env from
# workshop.yaml into hooks, and `setup-project` runs with /project as the
# repo working tree.
#
# Merge, never clobber: preserve any existing app-config.json (onboarding
# state, agent pick, user-added locations); only claim the default slot when
# the user has not chosen one. Runs on every setup-project, so it is idempotent
# across `workshop refresh`.
DATA_DIR="$HOME/.local/share/open-design"
PROJECT_ROOT="/project"
SEED_JS="$(mktemp)"
cat >"$SEED_JS" <<'EOF'
const { readFileSync, writeFileSync, mkdirSync } = require('node:fs');
const path = require('node:path');

const dataDir = process.argv[2];
const projectRoot = process.argv[3];
const LOC_ID = 'workshop';
const LOCATION_FILE = path.join(projectRoot, '.open-design-location');
const DEFAULT_LOCATION = path.join(dataDir, 'project');

// First non-empty, non-comment line of the override file wins; else default.
function resolveDesiredLocation() {
  let raw = '';
  try {
    for (const line of readFileSync(LOCATION_FILE, 'utf8').split(/\r?\n/)) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('#')) continue;
      raw = trimmed;
      break;
    }
  } catch { /* no override file: fall through to the default */ }
  if (!raw) return DEFAULT_LOCATION;
  return path.isAbsolute(raw)
    ? path.normalize(raw)
    : path.normalize(path.join(projectRoot, raw));
}

const desired = resolveDesiredLocation();
// The daemon rejects locations that do not exist on disk, so create it first.
mkdirSync(desired, { recursive: true });

const file = path.join(dataDir, 'app-config.json');
let cfg = {};
try {
  const parsed = JSON.parse(readFileSync(file, 'utf8'));
  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) cfg = parsed;
} catch { /* missing or corrupt: start from an empty config */ }

if (!Array.isArray(cfg.projectLocations)) cfg.projectLocations = [];
const existing = cfg.projectLocations.find((l) => l && l.id === LOC_ID);
if (existing) {
  // Track the basename only while the label is still auto-generated; if the
  // user renamed the location in the UI, keep their name.
  const autoNamed = !existing.name || existing.name === path.basename(existing.path);
  existing.path = desired;
  if (autoNamed) existing.name = path.basename(desired) || desired;
} else {
  cfg.projectLocations.push({ id: LOC_ID, name: path.basename(desired) || desired, path: desired });
}

// Own the default slot unless the user explicitly picked another location.
if (cfg.defaultProjectLocationId == null || cfg.defaultProjectLocationId === LOC_ID) {
  cfg.defaultProjectLocationId = LOC_ID;
}

mkdirSync(dataDir, { recursive: true });
writeFileSync(file, JSON.stringify(cfg, null, 2) + '\n');
EOF
mkdir -p "$PROJECT_ROOT"
"$SDK/opt/node/bin/node" "$SEED_JS" "$DATA_DIR" "$PROJECT_ROOT"
rm -f "$SEED_JS"

mkdir -p "$HOME/.config/systemd/user"
cat >"$HOME/.config/systemd/user/open-design.service" <<EOF
[Unit]
Description=Open Design headless daemon (web UI + API + MCP)
After=network.target

[Service]
Type=simple
WorkingDirectory=$SDK/opt/open-design
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=OD_BIND_HOST=127.0.0.1
Environment=OD_PORT=7456
Environment=OD_DATA_DIR=%h/.local/share/open-design
# Run the daemon through a login shell so it sources /etc/profile and
# /etc/profile.d/*.sh on every (re)start. That is how CLI-agent SDKs publish
# their custom bin dirs onto PATH; a "systemd --user" service does NOT read
# those files on its own, so without this the daemon inherits only the bare
# systemd PATH and cannot see the agent CLIs it is meant to drive. The login
# shell re-evaluates each restart, so a CLI SDK added by a later "workshop
# refresh" is picked up with a plain "systemctl --user restart open-design".
ExecStart=/usr/bin/bash -lc 'exec "$SDK/opt/node/bin/node" "$SDK/opt/open-design/apps/daemon/dist/cli.js" --no-open'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable --now open-design

# Seed a starter project once so the studio is usable immediately: import the
# default project location as a project, then "link local code" (attach the
# repo root /project as a read-only linked dir) so the agent can reference the
# surrounding codebase. Neither step needs AMR/vela sign-in — a headless,
# signed-out daemon (no OD_WORKSPACE_CONTEXT_SOURCE=vela) creates local,
# unbound projects and accepts plain-HTTP mutations on them.
#
# There is no `od` CLI verb for "link local code"; it is a project
# `metadata.linkedDirs` entry set via PATCH /api/projects/:id. We GET the
# project first and re-send its full metadata so the PATCH never wipes the
# import's baseDir/entryFile.
#
# Idempotent and best-effort: a marker in the persisted data dir gates the
# seed to exactly once per data volume, and the whole step is guarded so a
# daemon that is slow or unreachable never fails workshop setup — it simply
# retries on the next `workshop refresh` until it succeeds once.
OD_BASE="http://127.0.0.1:7456"
IMPORT_JS="$(mktemp)"
cat >"$IMPORT_JS" <<'EOF'
const { readFileSync, writeFileSync, existsSync, mkdirSync } = require('node:fs');
const path = require('node:path');

const dataDir = process.argv[2];
const projectRoot = process.argv[3];
const base = process.argv[4].replace(/\/$/, '');
const MARKER = path.join(dataDir, '.workshop-project-seeded');

// Seed once per data volume. A user who deletes the project in the UI should
// not have it resurrected on the next refresh.
if (existsSync(MARKER)) process.exit(0);

// The location seed above is the single source of truth for the project
// location: read the default project location it wrote into app-config.json.
function resolveLocation() {
  try {
    const cfg = JSON.parse(readFileSync(path.join(dataDir, 'app-config.json'), 'utf8'));
    const locs = Array.isArray(cfg.projectLocations) ? cfg.projectLocations : [];
    const byId = (id) => locs.find((l) => l && l.id === id);
    const loc =
      (cfg.defaultProjectLocationId ? byId(cfg.defaultProjectLocationId) : null) ||
      byId('workshop') ||
      locs[0];
    if (loc && typeof loc.path === 'string' && loc.path.trim()) return loc.path.trim();
  } catch { /* fall through to the default */ }
  return path.join(dataDir, 'project');
}

async function waitForHealth() {
  for (let i = 0; i < 60; i++) {
    try {
      const r = await fetch(`${base}/api/health`, { signal: AbortSignal.timeout(2000) });
      if (r.ok) return true;
    } catch { /* not up yet */ }
    await new Promise((res) => setTimeout(res, 1000));
  }
  return false;
}

async function main() {
  const baseDir = path.resolve(resolveLocation());
  mkdirSync(baseDir, { recursive: true });

  if (!(await waitForHealth())) {
    console.error('[open-design] daemon not healthy yet; skipping project seed (retries next refresh)');
    return;
  }

  // The signed-out import lands as an unbound local project, so it shows up in
  // the no-scope catalog: skip if one already points at this folder.
  try {
    const r = await fetch(`${base}/api/projects`);
    if (r.ok) {
      const data = await r.json();
      const projects = Array.isArray(data?.projects) ? data.projects : [];
      if (projects.some((p) => p?.metadata?.baseDir && path.resolve(p.metadata.baseDir) === baseDir)) {
        writeFileSync(MARKER, `${baseDir}\n`);
        return;
      }
    }
  } catch { /* dedup is best-effort; fall through to import */ }

  const importResp = await fetch(`${base}/api/import/folder`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ baseDir, name: path.basename(baseDir) || 'open-design' }),
  });
  if (!importResp.ok) {
    console.error(`[open-design] import failed: ${importResp.status} ${await importResp.text().catch(() => '')}`);
    return;
  }
  const projectId = (await importResp.json())?.project?.id;

  // "Link local code" to the repo root: GET the project and re-send its full
  // metadata with /project appended to linkedDirs so the PATCH preserves the
  // import's baseDir/entryFile (updateProject replaces metadata wholesale).
  if (projectId) {
    try {
      const cur = await fetch(`${base}/api/projects/${encodeURIComponent(projectId)}`);
      const meta = (cur.ok ? await cur.json() : null)?.project?.metadata ?? { kind: 'prototype' };
      const linkedDirs = Array.from(new Set([...(meta.linkedDirs ?? []), projectRoot]));
      const patchResp = await fetch(`${base}/api/projects/${encodeURIComponent(projectId)}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ metadata: { ...meta, linkedDirs } }),
      });
      if (!patchResp.ok) {
        console.error(`[open-design] link local code failed: ${patchResp.status} ${await patchResp.text().catch(() => '')}`);
      }
    } catch (err) {
      console.error(`[open-design] link local code error: ${err}`);
    }
  }

  writeFileSync(MARKER, `${baseDir}\n`);
}

main().catch((err) => console.error(`[open-design] project seed error: ${err}`));
EOF
"$SDK/opt/node/bin/node" "$IMPORT_JS" "$DATA_DIR" "$PROJECT_ROOT" "$OD_BASE" || true
rm -f "$IMPORT_JS"
