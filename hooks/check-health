#!/usr/bin/bash
# Runs as root after setup-project. Confirms the daemon is serving by probing
# its health endpoint; reports waiting while it is still coming up.
set -eu

if ! sudo -u workshop --login systemctl --user is-active --quiet open-design; then
    workshopctl set-health waiting "open-design service is not active yet"
    exit 0
fi

if ! output=$(curl -fsS --max-time 5 http://127.0.0.1:7456/api/health 2>&1); then
    workshopctl set-health waiting "open-design daemon not answering /api/health yet: $output"
    exit 0
fi

ip=$(hostname -I | awk '{print $1}')
echo -n "Open Design → tunnel open-design-server → http://127.0.0.1:7456 (workshop $ip)"
workshopctl set-health okay
