{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION$/"],
      "matchStrings": ["(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "nexu-io/open-design",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^open-design-v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "baseBranchPatterns": ["latest"],
  "packageRules": [
    {
      "matchPackageNames": ["nexu-io/open-design"],
      "matchBaseBranches": ["latest"]
    }
  ]
}
