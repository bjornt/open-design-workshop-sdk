[Unit]
Description=Open Design headless daemon (web UI + API + MCP)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/open-design
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=OD_BIND_HOST=127.0.0.1
Environment=OD_PORT=7456
Environment=OD_DATA_DIR=%h/.local/share/open-design
ExecStart=/opt/node/bin/node /opt/open-design/apps/daemon/dist/cli.js --no-open
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
